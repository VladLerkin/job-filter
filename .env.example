# Hirify Agent REST API Key (получить в https://hirify.me/mcp-api)
HIRIFY_API_KEY=your_hirify_api_key_here

# Apify API Token для скрапинга Upwork (получить в https://console.apify.com/settings/integrations)
APIFY_API_KEY=your_apify_api_token_here
# Опционально: ID актора Upwork на Apify (по умолчанию blackfalcondata~upwork-scraper)
# APIFY_UPWORK_ACTOR_ID=blackfalcondata~upwork-scraper
# UPWORK_PAYMENT_VERIFIED_ONLY=false

# Опциональные переопределения:
# JOB_FILTER_MODEL=gemini-3.8-flash-low
# JOB_FILTER_PORT=8000
# JOB_FILTER_HOST=0.0.0.0
# JOB_FILTER_DB=jobs.db

